{
  "name": "@granted/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Granted app: one React codebase for the iPhone app (Capacitor) and the mobile web page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "build:demo": "tsc -p . && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "jsqr": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@granted/core": "*",
    "@granted/services": "*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}